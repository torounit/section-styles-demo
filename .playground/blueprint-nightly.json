{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/",
	"login": true,
	"preferredVersions": {
		"php": "8.3",
		"wp": "nightly"
	},
	"steps": [
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Section Styles Demo",
				"blogdescription": "Block style variations for sections"
			}
		},
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"WP_DEBUG": true,
				"WP_DEBUG_LOG": true,
				"WP_DEBUG_DISPLAY": true,
				"SCRIPT_DEBUG": true
			}
		},
		{
			"step": "activateTheme",
			"themeFolderName": "section-styles-demo"
		}
	]
}
