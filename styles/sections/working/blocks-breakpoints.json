{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"slug": "blocks-breakpoints",
	"title": "Blocks @tablet / @mobile (7.1.3+)",
	"description": "styles.blocks.{block}.@tablet / @mobile（css 含む）。7.1.3 / 7.2 ともフロント・エディタで動作する。",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"blocks": {
			"core/separator": {
				"color": {
					"text": "red"
				},
				"@tablet": {
					"color": {
						"text": "green"
					}
				},
				"@mobile": {
					"color": {
						"text": "blue"
					},
					"css": "border-top-width: 6px;"
				}
			}
		}
	}
}
