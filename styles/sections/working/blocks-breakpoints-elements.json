{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"slug": "blocks-breakpoints-elements",
	"title": "Blocks @tablet / @mobile elements (7.1.3+)",
	"description": "styles.blocks.{block}.@tablet / @mobile 内の elements.{element}（css 含む）。7.1.3 / 7.2 ともフロント・エディタで動作する。",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"blocks": {
			"core/paragraph": {
				"elements": {
					"link": {
						"color": {
							"text": "red"
						}
					}
				},
				"@tablet": {
					"elements": {
						"link": {
							"color": {
								"text": "green"
							}
						}
					}
				},
				"@mobile": {
					"elements": {
						"link": {
							"color": {
								"text": "blue"
							},
							"css": "text-decoration-thickness: 4px;"
						}
					}
				}
			}
		}
	}
}
