{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#FFF",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "oklch(98.4% 0.003 247.858)",
					"name": "Subtle",
					"slug": "subtle"
				},
				{
					"color": "oklch(92.9% 0.013 255.508)",
					"name": "Muted",
					"slug": "muted"
				},
				{
					"color": "oklch(55.4% 0.046 257.417)",
					"name": "Dim",
					"slug": "dim"
				},
				{
					"color": "oklch(20.8% 0.042 265.755)",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "oklch(54.6% 0.245 262.881)",
					"name": "Accent",
					"slug": "accent"
				},
				{
					"color": "oklch(93.2% 0.032 255.585)",
					"name": "Accent Subtle",
					"slug": "accent-subtle"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "Tiny",
					"size": "calc( 0.5rem )",
					"slug": "20"
				},
				{
					"name": "X-Small",
					"size": "calc( 0.5rem * 2 )",
					"slug": "30"
				},
				{
					"name": "Small",
					"size": "calc( 0.5rem * 3 )",
					"slug": "40"
				},
				{
					"name": "Medium",
					"size": "calc( 0.5rem * 5 )",
					"slug": "50"
				},
				{
					"name": "Large",
					"size": "calc( 0.5rem * 8 )",
					"slug": "60"
				},
				{
					"name": "X-Large",
					"size": "calc( 0.5rem * 13 )",
					"slug": "70"
				}
			],
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
					"name": "System Font",
					"slug": "system-font"
				}
			],
			"fontSizes": [
				{
					"name": "Small",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"name": "Medium",
					"size": "1rem",
					"slug": "medium"
				},
				{
					"name": "Large",
					"size": "1.25rem",
					"slug": "large"
				},
				{
					"name": "Extra Large",
					"size": "1.75rem",
					"slug": "x-large"
				},
				{
					"name": "Extra Extra Large",
					"size": "clamp(2rem, 1.5rem + 2vw, 2.75rem)",
					"slug": "xx-large"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"blocks": {
			"core/quote": {
				"border": {
					"left": {
						"color": "var:preset|color|muted",
						"style": "solid",
						"width": "4px"
					}
				},
				"spacing": {
					"padding": {
						"left": "var:preset|spacing|50"
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|muted"
				}
			}
		},
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"elements": {
			"button": {
				"border": {
					"radius": "999px"
				},
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|base"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|30",
						"right": "var:preset|spacing|50",
						"bottom": "var:preset|spacing|30",
						"left": "var:preset|spacing|50"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|contrast"
					}
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.3"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|large"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|accent"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				}
			}
		},
		"spacing": {
			"blockGap": "var:preset|spacing|40",
			"padding": {
				"right": "var:preset|spacing|50",
				"left": "var:preset|spacing|50"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|system-font",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.75"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header"
		},
		{
			"area": "footer",
			"name": "footer"
		}
	]
}
